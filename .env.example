# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit your actual .env.
# Use independent, randomly generated passwords for external deployments.
POSTGRES_DB=adimarip
POSTGRES_USER=adimarip
POSTGRES_PASSWORD=adimarip_dev_password
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=LOCAL_DEMO_CHANGE_THIS_JWT_SIGNING_KEY_32CHARS_MIN
DEMO_ENABLED=true
DEMO_PASSWORD=demo-password-change-me
# Same-origin API: frontend nginx and Vite proxy /api to backend.
VITE_API_URL=
# Used only by docker_compose.prod.yml (HTTPS and no demo accounts).
# APP_DOMAIN=registry.example.org
# BOOTSTRAP_ADMIN_USERNAME=first-engineer
# BOOTSTRAP_ADMIN_PASSWORD=GENERATE_AN_UNIQUE_LONG_PASSWORD
